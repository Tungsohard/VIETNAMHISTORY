# README is the main Markdown document; the data-source notes are kept too.
**/*.md
!/README.md
!/data/sources/README.md

# Local thesis documents.
*.docx
*.pdf

# Python environments and caches.
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# Datasets (sources, processed ImageNet, protocol splits) stay local.
/data/*
!/data/sources/
/data/sources/*
!/data/sources/README.md

# Checkpoints and pretrained weights.
/checkpoints/
**/*.pth
**/*.pt
**/*.ckpt

# Generated outputs; keep only the product selection manifest.
/outputs/*
!/outputs/reports/
/outputs/reports/*
!/outputs/reports/production_selection.json

# OS and editor files.
.DS_Store
Thumbs.db
.idea/
.vscode/
