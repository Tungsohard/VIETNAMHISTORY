# README is the main Markdown document; the data-source notes are kept too.
**/*.md
!/README.md
!/data/sources/README.md

# Local thesis documents.
*.docx
*.pdf

# Python environments and caches.
**/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# Datasets (sources, processed ImageNet, protocol splits) stay local.
/data/*
!/data/sources/
/data/sources/*
!/data/sources/README.md

# Checkpoints and pretrained weights.
/checkpoints/
**/*.pth
**/*.pt
**/*.ckpt

# Generated outputs; keep only the product selection manifest.
/outputs/*
!/outputs/reports/
/outputs/reports/*

# OS and editor files.
.DS_Store
Thumbs.db
.idea/
.vscode/

# Deployment bundles.
/build/

!/outputs/reports/baseline_selection.json
/extracted_content/
# Statistical reports cited in the README
!/outputs/reports/seed_variance.json
!/outputs/reports/seed_variance.md
!/outputs/reports/pipeline_raw.json
!/outputs/reports/pipeline_raw.md
!/outputs/reports/pipeline_refined.json
!/outputs/reports/pipeline_refined.md
!/outputs/reports/pipeline_refined_sam.json
!/outputs/reports/pipeline_refined_sam.md
!/outputs/reports/statistical_comparison_official.json
!/outputs/reports/statistical_comparison_official.md
!/outputs/reports/colour_cast.json
!/outputs/reports/degradation_robustness.json
!/outputs/reports/colour_cast_skin.json
